# ---------------------------------------------------------------------------
# Microscopy data. These are large, they are the raw record of an unpublished
# experiment, and a single .lif archive can exceed the size of everything else
# in the repository combined. Nothing under a data directory is tracked;
# the synthetic fixtures under tests/fixtures/ are the exception and are
# whitelisted below.
# ---------------------------------------------------------------------------
*.lif
*.lifext
*.czi
*.nd2
*.oib
*.tif
*.tiff
data/
raw/
FRAP/

# Analysis outputs. Regenerated by `frap run`; tracking them means every rerun
# produces a diff of binary figures.
outputs/
results/
*_results/
*.png
*.svg
*.pdf
!docs/**/*.png
!docs/**/*.svg

# Derived tables are deliberately NOT ignored: see docs/reproducing.md.
!tests/fixtures/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and platforms
.vscode/
.idea/
.DS_Store

# Development markdowns
SETUP.md
CHANGELOG.md
